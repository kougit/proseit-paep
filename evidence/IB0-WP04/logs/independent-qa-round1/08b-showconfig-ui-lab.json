{
    "compilerOptions": {
        "paths": {
            "@proseit/paep-analytics": [
                "./packages/analytics/src/index.ts"
            ],
            "@proseit/paep-components": [
                "./packages/components/src/index.ts"
            ],
            "@proseit/paep-contracts": [
                "./packages/contracts/src/index.ts"
            ],
            "@proseit/paep-domain-ai": [
                "./packages/domain-ai/src/index.ts"
            ],
            "@proseit/paep-domain-commerce": [
                "./packages/domain-commerce/src/index.ts"
            ],
            "@proseit/paep-domain-construction": [
                "./packages/domain-construction/src/index.ts"
            ],
            "@proseit/paep-domain-fiscal": [
                "./packages/domain-fiscal/src/index.ts"
            ],
            "@proseit/paep-domain-iot": [
                "./packages/domain-iot/src/index.ts"
            ],
            "@proseit/paep-domain-maintenance": [
                "./packages/domain-maintenance/src/index.ts"
            ],
            "@proseit/paep-domain-manufacturing": [
                "./packages/domain-manufacturing/src/index.ts"
            ],
            "@proseit/paep-domain-quality": [
                "./packages/domain-quality/src/index.ts"
            ],
            "@proseit/paep-enterprise": [
                "./packages/enterprise/src/index.ts"
            ],
            "@proseit/paep-foundation": [
                "./packages/foundation/src/index.ts"
            ],
            "@proseit/frappe-sdk": [
                "./packages/frappe-sdk/src/index.ts"
            ],
            "@proseit/paep-i18n": [
                "./packages/i18n/src/index.ts"
            ],
            "@proseit/paep-observability": [
                "./packages/observability/src/index.ts"
            ],
            "@proseit/paep-offline": [
                "./packages/offline/src/index.ts"
            ],
            "@proseit/paep-platform": [
                "./packages/platform/src/index.ts"
            ]
        },
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2022",
        "module": "preserve",
        "types": [],
        "preserveConstEnums": true
    },
    "files": [
        "./src/main.ts",
        "./src/app/app.config.ts",
        "./src/app/app.routes.ts",
        "./src/app/app.ts"
    ],
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts"
    ]
}
