{
  "name": "@proseit/paep-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "build:reference-app": "ng build reference-app --configuration production",
    "build:ui-lab": "ng build ui-lab --configuration production",
    "qa:ib0-wp01": "node tooling/verification/verify-ib0-wp01.mjs",
    "qa:ib0-wp02": "node tooling/verification/verify-ib0-wp02.mjs",
    "qa:ib0-wp03": "node tooling/verification/verify-ib0-wp03.mjs",
    "qa:ib0-wp03:negative": "node tooling/verification/negative-ib0-wp03.mjs",
    "arch:check": "node tooling/architecture-boundaries/check-boundaries.mjs",
    "qa:architecture": "node tooling/architecture-boundaries/check-boundaries.mjs",
    "qa:ib0-wp04": "node tooling/verification/verify-ib0-wp04.mjs",
    "qa:ib0-wp04:negative": "node tooling/verification/negative-ib0-wp04.mjs",
    "qa:types": "ngc -p apps/reference-app/tsconfig.app.json --noEmit && ngc -p apps/ui-lab/tsconfig.app.json --noEmit",
    "qa:ib0-wp05": "node tooling/verification/verify-ib0-wp05.mjs",
    "qa:ib0-wp05:negative": "node tooling/verification/negative-ib0-wp05.mjs",
    "qa:baseline": "node tooling/governance/baseline-governance.mjs verify",
    "qa:baseline:negative": "node tooling/governance/negative-baseline-governance.mjs",
    "qa:contracts": "node tooling/test-utils/contracts-qa.mjs",
    "qa:runtime-config": "node tooling/config-validation/runtime-config-qa.mjs",
    "qa:runtime-config:negative": "node tooling/config-validation/negative-runtime-config.mjs",
    "qa:runtime-config:portability": "node tooling/config-validation/portability-proof.mjs",
    "qa:ib1": "npm run qa:contracts && npm run qa:runtime-config",
    "qa:ib1:negative": "npm run qa:runtime-config:negative && npm run qa:runtime-config:portability",
    "tokens:generate": "node tooling/design-system/generate-tokens.mjs",
    "test:components": "node tooling/design-system/run-component-tests.mjs",
    "qa:design-system": "node tooling/design-system/design-system-qa.mjs",
    "qa:design-system:negative": "node tooling/design-system/design-system-negative.mjs",
    "qa:accessibility": "node tooling/design-system/browser-qa.mjs",
    "qa:accessibility:negative": "node tooling/design-system/browser-qa-negative.mjs",
    "qa:ib2:ci-negative": "node tooling/design-system/ci-governance-negative.mjs",
    "test:enterprise": "node tooling/enterprise-shell/run-enterprise-tests.mjs",
    "qa:ddr07": "node tooling/enterprise-shell/ddr07-gate.mjs",
    "qa:ddr07:negative": "node tooling/enterprise-shell/ddr07-gate-negative.mjs",
    "qa:enterprise": "node tooling/enterprise-shell/enterprise-qa.mjs",
    "qa:enterprise:negative": "node tooling/enterprise-shell/enterprise-qa-negative.mjs && node tooling/enterprise-shell/design-system-extension-negative.mjs",
    "qa:shell": "node tooling/enterprise-shell/shell-qa.mjs",
    "qa:shell:negative": "node tooling/enterprise-shell/shell-qa-negative.mjs",
    "qa:ib3:ci-negative": "node tooling/enterprise-shell/ib3-ci-governance-negative.mjs"
  },
  "dependencies": {
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.8",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
