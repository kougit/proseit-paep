{
  "id": "files.list",
  "profile": "pmra-api-v1/frappe-15",
  "kind": "conformance",
  "description": "Attachment metadata of one record with the server checksum.",
  "steps": [
    {
      "call": {
        "port": "files",
        "method": "list",
        "args": [
          {
            "recordType": "inspection",
            "id": "INS-0001"
          }
        ]
      },
      "expect": {
        "resolves": [
          {
            "id": "f-0001",
            "fileName": "report.pdf",
            "contentType": "application/pdf",
            "sizeBytes": 2048,
            "checksum": {
              "algorithm": "md5",
              "value": "0123456789abcdef0123456789abcdef"
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/api/method/pmra.api.v1.get_compatibility"
      },
      "response": {
        "status": 200,
        "body": {
          "message": {
            "api_contract": "pmra-api-v1",
            "minimum_paep": "1.0",
            "maximum_paep": null
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/resource/File",
        "query": {
          "filters": "[[\"attached_to_doctype\",\"=\",\"PMRA Inspection\"],[\"attached_to_name\",\"=\",\"INS-0001\"]]"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "data": [
            {
              "name": "f-0001",
              "file_name": "report.pdf",
              "file_size": 2048,
              "content_hash": "0123456789abcdef0123456789abcdef"
            }
          ]
        }
      }
    }
  ]
}
