{
  "id": "session.csrf-rejected",
  "profile": "pmra-api-v1/frappe-15",
  "kind": "security",
  "description": "Server rejects the CSRF token on sign-out: authentication error, token still cleared.",
  "steps": [
    {
      "call": {
        "port": "session",
        "method": "check",
        "args": []
      },
      "expect": {
        "resolves": {
          "status": "authenticated",
          "identity": {
            "principalId": "inspector@example.test",
            "displayName": "Example Inspector",
            "tenant": {
              "tenantId": "tenant-01",
              "displayName": "Example Tenant"
            }
          }
        }
      }
    },
    {
      "call": {
        "port": "session",
        "method": "signOut",
        "args": []
      },
      "expect": {
        "rejects": {
          "code": "CSRF_REJECTED",
          "category": "authentication",
          "retryable": false,
          "correlationId": "$correlation"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/api/method/frappe.auth.get_logged_user"
      },
      "response": {
        "status": 200,
        "body": {
          "message": "inspector@example.test"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/method/pmra.api.v1.get_session"
      },
      "response": {
        "status": 200,
        "body": {
          "message": {
            "user": "inspector@example.test",
            "full_name": "Example Inspector",
            "tenant": {
              "id": "tenant-01",
              "name": "Example Tenant"
            },
            "csrf_token": "synthetic0csrf0token0value0001",
            "capabilities": [
              {
                "id": "inspection.create",
                "enabled": true
              },
              {
                "id": "inspection.approve",
                "enabled": false
              },
              {
                "id": "site.read",
                "enabled": true
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/method/logout",
        "csrf": true
      },
      "response": {
        "status": 400,
        "body": {
          "exc_type": "CSRFTokenError",
          "exception": "frappe.exceptions.CSRFTokenError: synthetic internal detail",
          "exc": "[\"Traceback (most recent call last): synthetic\"]",
          "_server_messages": "[\"{\\\"message\\\": \\\"synthetic server prose\\\"}\"]"
        }
      }
    }
  ]
}
