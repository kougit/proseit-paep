{
  "policyVersion": 1,
  "workPackage": "IB0-WP05",
  "note": "Machine-readable CI policy checked by tooling/verification/verify-ib0-wp05.mjs. The human-readable action register is docs/provenance/GITHUB-ACTIONS-REGISTER.md; both must list the same actions, versions and commit SHAs. Change this file only in a reviewed change that also updates the register.",
  "workflow": {
    "path": ".github/workflows/paep-ci.yml",
    "name": "PAEP CI",
    "setupAction": ".github/actions/paep-setup/action.yml",
    "runner": "ubuntu-24.04",
    "triggers": {
      "pull_request": {
        "branches": [
          "main"
        ]
      },
      "push": {
        "branches": [
          "main"
        ]
      },
      "workflow_dispatch": null
    },
    "forbiddenTriggers": [
      "pull_request_target",
      "workflow_run",
      "issue_comment",
      "pull_request_review",
      "pull_request_review_comment",
      "repository_dispatch",
      "schedule",
      "check_run",
      "check_suite",
      "discussion_comment"
    ],
    "topLevelPermissions": {
      "contents": "read"
    },
    "concurrency": {
      "group": "paep-ci-${{ github.event.pull_request.number || github.sha }}",
      "cancelInProgress": "${{ github.event_name == 'pull_request' }}"
    },
    "topLevelKeys": [
      "name",
      "on",
      "permissions",
      "concurrency",
      "jobs"
    ]
  },
  "gate": {
    "id": "gate",
    "name": "PAEP / gate",
    "requiredCheckContext": "PAEP / gate",
    "if": "${{ always() }}",
    "permissions": {},
    "run": "set -euo pipefail\nfail=0\nactual=\"$(jq -r 'keys[]' <<<\"$NEEDS_JSON\" | sort | tr '\\n' ' ')\"\nexpected=\"$(tr ' ' '\\n' <<<\"$MANDATORY_JOBS\" | sed '/^$/d' | sort | tr '\\n' ' ')\"\nif [ \"$actual\" != \"$expected\" ]; then\n  echo \"::error title=PAEP gate::needs [$actual] differ from the mandatory jobs [$expected]\"\n  fail=1\nfi\nfor job in $MANDATORY_JOBS; do\n  result=\"$(jq -r --arg job \"$job\" '.[$job].result // \"missing\"' <<<\"$NEEDS_JSON\")\"\n  echo \"$job: $result\"\n  echo \"| $job | $result |\" >> \"${GITHUB_STEP_SUMMARY:-/dev/null}\"\n  if [ \"$result\" != \"success\" ]; then\n    echo \"::error title=PAEP gate::mandatory job $job finished with result '$result'\"\n    fail=1\n  fi\ndone\nif [ \"$fail\" -ne 0 ]; then\n  echo \"PAEP gate: FAIL\"\n  exit 1\nfi\necho \"PAEP gate: PASS\"\n"
  },
  "mandatoryJobs": [
    {
      "id": "governance",
      "name": "PAEP / governance"
    },
    {
      "id": "provenance",
      "name": "PAEP / security-provenance"
    },
    {
      "id": "architecture",
      "name": "PAEP / architecture"
    },
    {
      "id": "strictness",
      "name": "PAEP / strictness"
    },
    {
      "id": "negative-architecture",
      "name": "PAEP / negative-architecture"
    },
    {
      "id": "negative-ci",
      "name": "PAEP / negative-ci"
    },
    {
      "id": "regression",
      "name": "PAEP / regression"
    },
    {
      "id": "contracts",
      "name": "PAEP / contracts"
    },
    {
      "id": "runtime-config",
      "name": "PAEP / runtime-config"
    },
    {
      "id": "runtime-config-negative",
      "name": "PAEP / runtime-config-negative"
    },
    {
      "id": "components",
      "name": "PAEP / components"
    },
    {
      "id": "accessibility",
      "name": "PAEP / accessibility"
    },
    {
      "id": "negative-ci-b",
      "name": "PAEP / negative-ci-b"
    },
    {
      "id": "build-reference-app",
      "name": "PAEP / build-reference-app"
    },
    {
      "id": "build-ui-lab",
      "name": "PAEP / build-ui-lab"
    }
  ],
  "requiredCommands": {
    "governance": [
      "node tooling/verification/verify-ib0-wp05.mjs --gate governance"
    ],
    "provenance": [
      "node tooling/verification/verify-ib0-wp05.mjs --gate provenance",
      "npm audit signatures"
    ],
    "architecture": [
      "npm run qa:architecture"
    ],
    "strictness": [
      "npm run qa:types",
      "node tooling/verification/verify-ib0-wp05.mjs --gate strictness"
    ],
    "negative-architecture": [
      "node tooling/verification/verify-ib0-wp05.mjs --gate negative-architecture"
    ],
    "negative-ci": [
      "npm run qa:ib0-wp05:negative -- --part a",
      "npm run qa:baseline:negative"
    ],
    "regression": [
      "node tooling/verification/verify-ib0-wp05.mjs --gate regression"
    ],
    "contracts": [
      "npm run qa:contracts"
    ],
    "runtime-config": [
      "npm run qa:runtime-config"
    ],
    "runtime-config-negative": [
      "npm run qa:runtime-config:negative",
      "npm run qa:runtime-config:portability"
    ],
    "components": [
      "npm run test:components",
      "npm run qa:design-system",
      "npm run qa:design-system:negative",
      "npm run qa:ib2:ci-negative"
    ],
    "accessibility": [
      "npm run build:ui-lab",
      "npm run qa:accessibility",
      "npm run qa:accessibility:negative"
    ],
    "negative-ci-b": [
      "npm run qa:ib0-wp05:negative -- --part b"
    ],
    "build-reference-app": [
      "npm run build:reference-app",
      "node tooling/verification/verify-ib0-wp05.mjs --gate build-metadata --app reference-app"
    ],
    "build-ui-lab": [
      "npm run build:ui-lab",
      "node tooling/verification/verify-ib0-wp05.mjs --gate build-metadata --app ui-lab"
    ]
  },
  "approvedActions": [
    {
      "action": "actions/checkout",
      "version": "v7.0.1",
      "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1",
      "licence": "MIT",
      "publisher": "GitHub (first-party)",
      "purpose": "Check out the commit under test"
    },
    {
      "action": "actions/setup-node",
      "version": "v7.0.0",
      "sha": "820762786026740c76f36085b0efc47a31fe5020",
      "licence": "MIT",
      "publisher": "GitHub (first-party)",
      "purpose": "Install the pinned Node.js from .nvmrc and cache npm downloads"
    },
    {
      "action": "actions/upload-artifact",
      "version": "v7.0.1",
      "sha": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
      "licence": "MIT",
      "publisher": "GitHub (first-party)",
      "purpose": "Retain per-job CI evidence"
    }
  ],
  "approvedLocalActions": [
    "./.github/actions/paep-setup"
  ],
  "artifactRetentionDays": 30,
  "setupSteps": [
    {
      "name": "Set up Node.js from .nvmrc",
      "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020",
      "with": {
        "node-version-file": ".nvmrc",
        "check-latest": false,
        "cache": "npm",
        "cache-dependency-path": "package-lock.json"
      }
    },
    {
      "name": "Prepare evidence directory",
      "shell": "bash",
      "run": "set -euo pipefail\nmkdir -p \"$RUNNER_TEMP/paep-evidence\"\necho \"PAEP_EVIDENCE_DIR=$RUNNER_TEMP/paep-evidence\" >> \"$GITHUB_ENV\"\n"
    },
    {
      "name": "Toolchain gate (Node/npm against .nvmrc, devEngines, packageManager and the version manifest)",
      "shell": "bash",
      "run": "set -euo pipefail\nnode tooling/verification/verify-ib0-wp05.mjs --gate toolchain 2>&1 | tee \"$RUNNER_TEMP/paep-evidence/toolchain.log\"\n"
    },
    {
      "name": "Clean install from the committed lockfile (npm ci)",
      "shell": "bash",
      "run": "set -euo pipefail\nnpm ci 2>&1 | tee \"$RUNNER_TEMP/paep-evidence/npm-ci.log\"\n"
    },
    {
      "name": "Installation left every tracked file unchanged",
      "shell": "bash",
      "run": "set -euo pipefail\ngit diff --exit-code -- package.json package-lock.json\nstatus=\"$(git status --porcelain)\"\nif [ -n \"$status\" ]; then\n  echo \"::error title=PAEP setup::npm ci changed the working tree\"\n  printf '%s\\n' \"$status\"\n  exit 1\nfi\nsha256sum package-lock.json | tee \"$RUNNER_TEMP/paep-evidence/lockfile.sha256\"\n"
    }
  ]
}
